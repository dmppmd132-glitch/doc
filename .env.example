# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY:
# Your modern Supabase Publishable API key (sbp_... or eyJhbGciOi...)
VITE_SUPABASE_PUBLISHABLE_KEY="sbp_YOUR_PUBLISHABLE_KEY"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# S3-Compatible Object Storage: Cloudflare R2 OR Backblaze B2 (Server-side only — DO NOT prefix with VITE_)
# Leave empty to automatically use Supabase Storage (1 GB free, <= 50 MB/file) for pilot testing.
# For Cloudflare R2: set R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
# For Backblaze B2: set R2_ENDPOINT (e.g. https://s3.us-west-004.backblazeb2.com), R2_REGION (e.g. us-west-004), R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="apex-dms-files"
